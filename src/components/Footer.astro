---
import { SITE, WHATSAPP_URL } from '../consts';

const year = new Date().getFullYear();

const links = [
  { href: '/#services', label: 'Services' },
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: WHATSAPP_URL, label: 'WhatsApp' },
];
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <span class="font-display text-xl tracking-tight text-ink">{SITE.shortName}</span>
      <p class="mt-3 max-w-xs text-sm text-muted">
        {SITE.name} — {SITE.domain}
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
      {
        links.map((link) => (
          <a href={link.href} class="text-sm text-muted transition-colors hover:text-ink">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="mx-auto max-w-6xl px-6 pb-10">
    <p class="text-xs text-muted">&copy; {year} {SITE.name}</p>
  </div>
</footer>
